# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dip?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Gateway
AI_GATEWAY_URL=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_ENABLED="true"
GEMINI_ENABLED="true"
AI_WORKER_CONCURRENCY="2"
AI_RATE_LIMIT_PER_MINUTE="10"
AI_PROVIDER_TIMEOUT_MS="60000"
MAX_AI_OUTPUT_TOKENS="8192"
GEMINI_INPUT_USD_PER_MILLION="0.30"
GEMINI_OUTPUT_USD_PER_MILLION="2.50"

# Storage (S3-compatible: Neon Object Storage baseline, R2/MinIO/AWS interchangeable)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-2"
# For Neon Object Storage: use its injected AWS_* credentials and set this bucket name.
S3_DOCUMENTS_BUCKET="dip-documents"

# Auth (generate a long random value for production)
AUTH_SECRET="change-me-in-production"
# OAuth provider credentials (enable a provider only after configuring its callback URL)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Phase 6 runtime safety budgets (initial operational defaults; not product SLOs)
DOCUMENT_WORKER_CONCURRENCY="2"
JOB_TIMEOUT_MS="180000"
LIBREOFFICE_TIMEOUT_MS="120000"
OCR_TIMEOUT_MS="300000"
STORAGE_TIMEOUT_MS="30000"
QUEUE_STALLED_INTERVAL_MS="30000"
QUEUE_MAX_STALLED_COUNT="1"
MAX_INPUT_BYTES="104857600"
MAX_PDF_PAGES="500"
MAX_RENDERED_PIXELS_PER_PAGE="40000000"
MAX_OUTPUT_FILES="500"
MAX_OUTPUT_BYTES="262144000"
MAX_EXTRACTED_TEXT_CHARS="2000000"

# Optional production error reporting. Sentry SDK/project adoption remains a Decision Gate.
SENTRY_DSN=""

# Phase 2 processing engines (server-only; executables must be on PATH)
# LibreOffice supplies `soffice` for Office conversion; OCRmyPDF supplies `ocrmypdf`.
