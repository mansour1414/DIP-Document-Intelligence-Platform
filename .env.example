# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dip?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Gateway
AI_GATEWAY_URL=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Storage (S3-compatible: Neon Object Storage baseline, R2/MinIO/AWS interchangeable)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-2"
# For Neon Object Storage: use its injected AWS_* credentials and set this bucket name.
S3_DOCUMENTS_BUCKET="dip-documents"

# Auth (generate a long random value for production)
AUTH_SECRET="change-me-in-production"
# OAuth provider credentials (enable a provider only after configuring its callback URL)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Phase 2 processing engines (server-only; executables must be on PATH)
# LibreOffice supplies `soffice` for Office conversion; OCRmyPDF supplies `ocrmypdf`.
