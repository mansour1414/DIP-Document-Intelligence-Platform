# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dip?schema=public"
# Direct, non-pooled URL used only by migrations, role bootstrap, dumps and restores.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/dip?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Gateway
AI_GATEWAY_URL=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
AI_ENABLED="true"
GEMINI_ENABLED="true"
AI_WORKER_CONCURRENCY="2"
AI_RATE_LIMIT_PER_MINUTE="10"
AI_PROVIDER_TIMEOUT_MS="60000"
MAX_AI_OUTPUT_TOKENS="8192"
GEMINI_INPUT_USD_PER_MILLION="0.30"
GEMINI_OUTPUT_USD_PER_MILLION="2.50"

# Storage (S3-compatible: Neon Object Storage baseline, R2/MinIO/AWS interchangeable)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-2"
# For Neon Object Storage: use its injected AWS_* credentials and set this bucket name.
S3_DOCUMENTS_BUCKET="dip-documents"

# Fail-closed malware scanner (private clamd endpoint; never expose publicly)
CLAMD_HOST="localhost"
CLAMD_PORT="3310"
MALWARE_SCAN_TIMEOUT_MS="30000"
MALWARE_SCAN_MAX_BYTES="104857600"

# Auth (generate a long random value for production)
AUTH_SECRET="change-me-in-production"
API_KEY_PEPPER="change-me-in-production"
RATE_LIMIT_KEY_SECRET="change-me-in-production"
API_RATE_LIMIT_CLIENT_PER_MINUTE="120"
API_RATE_LIMIT_ORGANIZATION_PER_MINUTE="1000"
# OAuth provider credentials (enable a provider only after configuring its callback URL)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Phase 6 runtime safety budgets (initial operational defaults; not product SLOs)
DOCUMENT_WORKER_CONCURRENCY="2"
JOB_TIMEOUT_MS="180000"
LIBREOFFICE_TIMEOUT_MS="120000"
OCR_TIMEOUT_MS="300000"
STORAGE_TIMEOUT_MS="30000"
QUEUE_STALLED_INTERVAL_MS="30000"
QUEUE_MAX_STALLED_COUNT="1"
MAX_INPUT_BYTES="104857600"
MAX_PDF_PAGES="500"
MAX_RENDERED_PIXELS_PER_PAGE="40000000"
MAX_OUTPUT_FILES="500"
MAX_OUTPUT_BYTES="262144000"
MAX_EXTRACTED_TEXT_CHARS="2000000"

# Optional production error reporting. Sentry SDK/project adoption remains a Decision Gate.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
RETENTION_APPLY="0"
ALERT_JOB_FAILURE_RATE="0.05"
ALERT_QUEUE_DEPTH="100"
ALERT_STUCK_JOB_MINUTES="10"
ALERT_STORAGE_FAILURES_5M="5"
ALERT_MALWARE_SCANNER_FAILURES_5M="3"
ALERT_SECURITY_EVENTS_5M="10"
ALERT_DEPENDENCY_UNAVAILABLE_MINUTES="2"
ALERT_AI_FAILURE_RATE="0.10"
ALERT_AI_COST_PER_HOUR="0"
ALERT_CLEANUP_FAILURES="1"
ALERT_TEMP_DISK_USED_RATIO="0.80"
COST_CPU_PER_MS="0"
COST_MEMORY_MB_MS="0"
COST_STORAGE_BYTE="0"
COST_STORAGE_OPERATION="0"
COST_AI_INPUT_TOKEN="0"
COST_AI_OUTPUT_TOKEN="0"
COST_OCR_PAGE="0"
COST_OFFICE_MS="0"

# Phase 2 processing engines (server-only; executables must be on PATH)
# LibreOffice supplies `soffice` for Office conversion; OCRmyPDF supplies `ocrmypdf`.
