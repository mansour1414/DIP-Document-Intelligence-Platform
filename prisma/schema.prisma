generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== IDENTITY ====================

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique @db.VarChar(255)
  passwordHash   String?    @map("password_hash") @db.VarChar(255)
  externalAuthId String?    @map("external_auth_id") @db.VarChar(255)
  displayName    String?    @map("display_name") @db.VarChar(100)
  locale         String     @default("en") @db.VarChar(5)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  memberships       Membership[]
  apiKeys           ApiKey[]
  jobs              Job[]            @relation("RequesterJobs")
  documents         Document[]
  aiConversations   AiConversation[]
  aiUsage           AiUsage[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  payments          Payment[]
  creditPurchases   CreditPurchase[]
  usageEvents       UsageEvent[]
  billingEvents     BillingEvent[]
  accounts          Account[]
  sessions          Session[]
  creditLedger      CreditLedger[]
  fileVersions      FileVersion[]
  workflows         Workflow[]
  workflowRuns      WorkflowRun[]
  agentRuns         AgentRun[]
  createdApiClients ApiClient[]      @relation("ApiClientCreator")

  @@index([status])
  @@map("users")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(100)
  slug      String             @unique @db.VarChar(100)
  plan      Plan               @default(FREE)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  memberships           Membership[]
  teams                 Team[]
  documents             Document[]
  apiClients            ApiClient[]
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  apiIdempotencyRecords ApiIdempotencyRecord[]
  apiUsage              ApiUsage[]
  jobs                  Job[]

  @@map("organizations")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  memberships  Membership[]

  @@index([organizationId])
  @@map("teams")
}

model Membership {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  teamId         String?    @map("team_id") @db.Uuid
  role           MemberRole @default(MEMBER)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([teamId])
  @@map("memberships")
}

model ApiKey {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String?             @map("user_id") @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  apiClientId    String?             @map("api_client_id") @db.Uuid
  name           String              @db.VarChar(100)
  keyHash        String              @map("key_hash") @db.VarChar(255)
  keyPrefix      String?             @unique @map("key_prefix") @db.VarChar(32)
  status         ApiCredentialStatus @default(ACTIVE)
  scopes         Json                @default("[]")
  expiresAt      DateTime?           @map("expires_at")
  lastUsedAt     DateTime?           @map("last_used_at")
  revokedAt      DateTime?           @map("revoked_at")
  rotatedFromId  String?             @map("rotated_from_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiClient    ApiClient?    @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  rotatedFrom  ApiKey?       @relation("ApiKeyRotations", fields: [rotatedFromId], references: [id])
  rotations    ApiKey[]      @relation("ApiKeyRotations")

  @@index([userId])
  @@index([organizationId, status])
  @@index([apiClientId, status])
  @@map("api_keys")
}

model ApiClient {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  name            String          @db.VarChar(100)
  status          ApiClientStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User                   @relation("ApiClientCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  apiKeys            ApiKey[]
  idempotencyRecords ApiIdempotencyRecord[]
  jobs               Job[]
  apiUsage           ApiUsage[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("api_clients")
}

model ApiIdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  apiClientId    String   @map("api_client_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  resourceType   String?  @map("resource_type") @db.VarChar(50)
  resourceId     String?  @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiClient    ApiClient    @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@unique([apiClientId, idempotencyKey])
  @@index([organizationId, expiresAt])
  @@map("api_idempotency_records")
}

model Account {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String    @db.VarChar(50)
  providerAccountId String    @map("provider_account_id") @db.VarChar(255)
  accessToken       String?   @map("access_token") @db.Text
  refreshToken      String?   @map("refresh_token") @db.Text
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ==================== DOCUMENTS ====================

model Document {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  title          String         @db.VarChar(255)
  status         DocumentStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  files           File[]
  aiConversations AiConversation[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("documents")
}

model File {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  originalName    String   @map("original_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  size            BigInt   @db.BigInt
  storageKey      String   @map("storage_key") @db.VarChar(500)
  storageObjectId String?  @map("storage_object_id") @db.Uuid
  checksum        String?  @db.VarChar(64)
  pageCount       Int?     @map("page_count")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  document      Document       @relation(fields: [documentId], references: [id])
  storageObject StorageObject? @relation(fields: [storageObjectId], references: [id])
  jobInputs     Job[]          @relation("InputFiles")
  jobOutputs    Job[]          @relation("OutputFiles")
  versions      FileVersion[]

  @@index([documentId])
  @@index([storageObjectId])
  @@map("files")
}

model FileVersion {
  id         String   @id @default(uuid()) @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  version    Int
  storageKey String   @map("storage_key") @db.VarChar(500)
  checksum   String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  file  File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id])

  @@unique([fileId, version])
  @@index([ownerId, createdAt])
  @@map("file_versions")
}

model StorageObject {
  id        String    @id @default(uuid()) @db.Uuid
  provider  String    @db.VarChar(50)
  bucket    String    @db.VarChar(255)
  objectKey String    @map("object_key") @db.VarChar(500)
  region    String?   @db.VarChar(100)
  size      BigInt
  checksum  String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  files     File[]

  @@unique([provider, bucket, objectKey])
  @@map("storage_objects")
}

// ==================== PROCESSING ====================

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  toolId         String    @map("tool_id") @db.VarChar(50)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(255)
  requesterId    String?   @map("requester_id") @db.Uuid
  inputFileId    String?   @map("input_file_id") @db.Uuid
  outputFileId   String?   @map("output_file_id") @db.Uuid
  status         JobStatus @default(QUEUED)
  params         Json      @default("{}")
  result         Json?
  error          Json?
  correlationId  String?   @map("correlation_id") @db.Uuid
  errorCode      String?   @map("error_code") @db.VarChar(100)
  engine         String?   @db.VarChar(100)
  engineVersion  String?   @map("engine_version") @db.VarChar(100)
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workflowRunId  String?   @map("workflow_run_id") @db.Uuid
  workflowNodeId String?   @map("workflow_node_id") @db.VarChar(100)
  organizationId String?   @map("organization_id") @db.Uuid
  apiClientId    String?   @map("api_client_id") @db.Uuid

  requester      User?           @relation("RequesterJobs", fields: [requesterId], references: [id])
  inputFile      File?           @relation("InputFiles", fields: [inputFileId], references: [id])
  outputFile     File?           @relation("OutputFiles", fields: [outputFileId], references: [id])
  steps          JobStep[]
  events         JobEvent[]
  toolExecutions ToolExecution[]
  workflowRun    WorkflowRun?    @relation(fields: [workflowRunId], references: [id], onDelete: Restrict)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  apiClient      ApiClient?      @relation(fields: [apiClientId], references: [id], onDelete: Restrict)

  @@unique([toolId, idempotencyKey])
  @@unique([workflowRunId, workflowNodeId])
  @@index([requesterId])
  @@index([status])
  @@index([toolId])
  @@index([createdAt])
  @@index([requesterId, correlationId])
  @@index([workflowRunId, status])
  @@index([organizationId, apiClientId, createdAt])
  @@map("jobs")
}

// ==================== WORKFLOWS ====================

model Workflow {
  id               String         @id @default(uuid()) @db.Uuid
  ownerId          String         @map("owner_id") @db.Uuid
  name             String         @db.VarChar(120)
  status           WorkflowStatus @default(ACTIVE)
  currentVersionId String?        @unique @map("current_version_id") @db.Uuid
  origin           WorkflowOrigin @default(USER)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions       WorkflowVersion[] @relation("WorkflowVersions")
  currentVersion WorkflowVersion?  @relation("CurrentWorkflowVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, updatedAt])
  @@map("workflows")
}

model AgentRun {
  id                   String             @id @default(uuid()) @db.Uuid
  ownerId              String             @map("owner_id") @db.Uuid
  status               AgentRunStatus     @default(REQUESTED)
  locale               String             @db.VarChar(5)
  request              String             @db.Text
  scope                Json
  trustedBudget        Json               @map("trusted_budget")
  allowedToolIds       Json               @map("allowed_tool_ids")
  correlationId        String             @unique @map("correlation_id") @db.Uuid
  idempotencyKey       String             @map("idempotency_key") @db.VarChar(255)
  currentPlanVersionId String?            @unique @map("current_plan_version_id") @db.Uuid
  workflowRunId        String?            @unique @map("workflow_run_id") @db.Uuid
  verification         Json?
  evidence             Json?
  errorCode            String?            @map("error_code") @db.VarChar(100)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  completedAt          DateTime?          @map("completed_at")
  owner                User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  plans                AgentPlanVersion[] @relation("AgentPlans")
  currentPlanVersion   AgentPlanVersion?  @relation("CurrentAgentPlan", fields: [currentPlanVersionId], references: [id], onDelete: Restrict)
  workflowRun          WorkflowRun?       @relation(fields: [workflowRunId], references: [id], onDelete: Restrict)
  aiUsage              AiUsage[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, status, createdAt])
  @@map("agent_runs")
}

model AgentPlanVersion {
  id                String           @id @default(uuid()) @db.Uuid
  agentRunId        String           @map("agent_run_id") @db.Uuid
  version           Int
  draft             Json
  resolvedScope     Json             @map("resolved_scope")
  budgetPreview     Json             @map("budget_preview")
  approval          Json
  state             String           @db.VarChar(30)
  frozenPlan        Json?            @map("frozen_plan")
  integrityHash     String?          @map("integrity_hash") @db.VarChar(64)
  workflowVersionId String?          @unique @map("workflow_version_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  agentRun          AgentRun         @relation("AgentPlans", fields: [agentRunId], references: [id], onDelete: Restrict)
  currentFor        AgentRun?        @relation("CurrentAgentPlan")
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)

  @@unique([agentRunId, version])
  @@index([agentRunId, createdAt])
  @@map("agent_plan_versions")
}

model WorkflowVersion {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  version    Int
  definition Json
  createdAt  DateTime @default(now()) @map("created_at")

  workflow   Workflow          @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Restrict)
  currentFor Workflow?         @relation("CurrentWorkflowVersion")
  runs       WorkflowRun[]
  agentPlan  AgentPlanVersion?

  @@unique([workflowId, version])
  @@index([workflowId, createdAt])
  @@map("workflow_versions")
}

model WorkflowRun {
  id                String    @id @default(uuid()) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  workflowVersionId String    @map("workflow_version_id") @db.Uuid
  status            JobStatus @default(QUEUED)
  inputs            Json      @default("{}")
  result            Json?
  error             Json?
  errorCode         String?   @map("error_code") @db.VarChar(100)
  correlationId     String    @map("correlation_id") @db.Uuid
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  cancelledAt       DateTime? @map("cancelled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  jobs            Job[]
  agentRun        AgentRun?

  @@index([ownerId, status, createdAt])
  @@index([workflowVersionId])
  @@map("workflow_runs")
}

model JobStep {
  id             String    @id @default(uuid()) @db.Uuid
  jobId          String    @map("job_id") @db.Uuid
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(255)
  name           String    @db.VarChar(100)
  status         JobStatus @default(QUEUED)
  input          Json?
  output         Json?
  error          Json?
  correlationId  String?   @map("correlation_id") @db.Uuid
  errorCode      String?   @map("error_code") @db.VarChar(100)
  engine         String?   @db.VarChar(100)
  engineVersion  String?   @map("engine_version") @db.VarChar(100)
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, idempotencyKey])
  @@index([jobId])
  @@map("job_steps")
}

model JobEvent {
  id            String   @id @default(uuid()) @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  type          String   @db.VarChar(50)
  data          Json     @default("{}")
  correlationId String?  @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_events")
}

model ToolExecution {
  id            String        @id @default(uuid()) @db.Uuid
  jobId         String        @map("job_id") @db.Uuid
  toolId        String        @map("tool_id") @db.VarChar(50)
  mode          ExecutionMode
  input         Json?
  output        Json?
  correlationId String?       @map("correlation_id") @db.Uuid
  errorCode     String?       @map("error_code") @db.VarChar(100)
  engine        String?       @db.VarChar(100)
  engineVersion String?       @map("engine_version") @db.VarChar(100)
  durationMs    Int?          @map("duration_ms")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([toolId])
  @@map("tool_executions")
}

// ==================== AI ====================

model AiConversation {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  title      String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt @map("updated_at")

  document Document    @relation(fields: [documentId], references: [id])
  messages AiMessage[]

  @@index([documentId])
  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           AiRole
  content        String   @db.Text
  model          String   @db.VarChar(100)
  tokensInput    Int?     @map("tokens_input")
  tokensOutput   Int?     @map("tokens_output")
  cost           Decimal? @db.Decimal(10, 6)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  jobId        String?  @map("job_id") @db.Uuid
  agentRunId   String?  @map("agent_run_id") @db.Uuid
  provider     String   @db.VarChar(50)
  model        String   @db.VarChar(100)
  taskType     String   @map("task_type") @db.VarChar(50)
  tokensInput  Int      @map("tokens_input")
  tokensOutput Int      @map("tokens_output")
  cost         Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([agentRunId])
  @@index([provider, model])
  @@index([createdAt])
  @@map("ai_usage")
}

model CreditLedger {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  type           CreditType
  amount         Decimal      @db.Decimal(10, 2)
  balance        Decimal      @db.Decimal(10, 2)
  reference      String?      @db.VarChar(255)
  idempotencyKey String       @map("idempotency_key") @db.VarChar(255)
  reason         CreditReason
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([createdAt])
  @@map("credit_ledger")
}

// ==================== BILLING ====================

model PlanCatalog {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.VarChar(32)
  name             String            @db.VarChar(100)
  status           PlanStatus        @default(ACTIVE)
  billingIntervals Json              @default("[]") @map("billing_intervals")
  currencies       Json              @default("[]")
  version          Int               @default(1)
  effectiveFrom    DateTime          @default(now()) @map("effective_from")
  effectiveTo      DateTime?         @map("effective_to")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  entitlements     PlanEntitlement[]
  subscriptions    Subscription[]

  @@unique([code, version])
  @@map("plans")
}

model PlanEntitlement {
  id        String      @id @default(uuid()) @db.Uuid
  planId    String      @map("plan_id") @db.Uuid
  key       String      @db.VarChar(100)
  value     Json
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  plan      PlanCatalog @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
  @@map("plan_entitlements")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  externalReference  String?            @map("external_reference") @db.VarChar(255)
  startsAt           DateTime           @default(now()) @map("starts_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id])
  plan     PlanCatalog @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@unique([externalReference])
  @@index([userId])
  @@index([userId, status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  subscriptionId    String?          @map("subscription_id") @db.Uuid
  number            String           @unique @db.VarChar(100)
  status            InvoiceStatus    @default(DRAFT)
  subtotalMinor     BigInt           @map("subtotal_minor")
  taxMinor          BigInt?          @map("tax_minor")
  totalMinor        BigInt           @map("total_minor")
  currency          String           @db.Char(3)
  issuedAt          DateTime         @default(now()) @map("issued_at")
  dueAt             DateTime?        @map("due_at")
  paidAt            DateTime?        @map("paid_at")
  externalReference String?          @unique @map("external_reference") @db.VarChar(255)
  createdAt         DateTime         @default(now()) @map("created_at")
  user              User             @relation(fields: [userId], references: [id])
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id])
  payments          Payment[]
  creditPurchases   CreditPurchase[]

  @@index([userId, issuedAt])
  @@map("invoices")
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  invoiceId         String?          @map("invoice_id") @db.Uuid
  amountMinor       BigInt           @map("amount_minor")
  currency          String           @db.Char(3)
  status            PaymentStatus    @default(PENDING)
  externalReference String?          @unique @map("external_reference") @db.VarChar(255)
  failureCode       String?          @map("failure_code") @db.VarChar(100)
  failureReason     String?          @map("failure_reason") @db.VarChar(500)
  paidAt            DateTime?        @map("paid_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  user              User             @relation(fields: [userId], references: [id])
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id])
  creditPurchases   CreditPurchase[]

  @@index([userId, createdAt])
  @@map("payments")
}

model CreditPurchase {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  invoiceId      String?              @map("invoice_id") @db.Uuid
  paymentId      String?              @map("payment_id") @db.Uuid
  credits        Decimal              @db.Decimal(12, 2)
  amountMinor    BigInt               @map("amount_minor")
  currency       String               @db.Char(3)
  status         CreditPurchaseStatus @default(PENDING)
  idempotencyKey String               @unique @map("idempotency_key") @db.VarChar(255)
  grantedAt      DateTime?            @map("granted_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  user           User                 @relation(fields: [userId], references: [id])
  invoice        Invoice?             @relation(fields: [invoiceId], references: [id])
  payment        Payment?             @relation(fields: [paymentId], references: [id])

  @@index([userId, createdAt])
  @@map("credit_purchases")
}

model UsageEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kind       String   @db.VarChar(50)
  quantity   Int      @default(1)
  reference  String   @db.VarChar(255)
  occurredAt DateTime @default(now()) @map("occurred_at")
  metadata   Json     @default("{}")
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, kind, reference])
  @@index([userId, kind, occurredAt])
  @@map("usage_events")
}

model ApiUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  apiClientId    String   @map("api_client_id") @db.Uuid
  requestId      String   @unique @map("request_id") @db.Uuid
  route          String   @db.VarChar(120)
  method         String   @db.VarChar(10)
  toolId         String?  @map("tool_id") @db.VarChar(50)
  statusCode     Int      @map("status_code")
  requestCount   Int      @default(1) @map("request_count")
  bytesIn        BigInt   @default(0) @map("bytes_in")
  bytesOut       BigInt   @default(0) @map("bytes_out")
  creditsUsed    Decimal  @default(0) @map("credits_used") @db.Decimal(12, 2)
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiClient    ApiClient    @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([apiClientId, occurredAt])
  @@index([toolId, occurredAt])
  @@map("api_usage")
}

model AiProviderPrice {
  id                    String    @id @default(uuid()) @db.Uuid
  provider              String    @db.VarChar(50)
  model                 String    @db.VarChar(100)
  inputPricePerMillion  Decimal   @map("input_price_per_million") @db.Decimal(18, 6)
  outputPricePerMillion Decimal   @map("output_price_per_million") @db.Decimal(18, 6)
  currency              String    @db.Char(3)
  effectiveFrom         DateTime  @map("effective_from")
  effectiveTo           DateTime? @map("effective_to")
  source                String?   @db.VarChar(255)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")

  @@unique([provider, model, effectiveFrom])
  @@index([provider, model, effectiveFrom, effectiveTo])
  @@map("ai_provider_prices")
}

model BillingEvent {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String?            @map("user_id") @db.Uuid
  provider        String             @db.VarChar(50)
  externalEventId String             @map("external_event_id") @db.VarChar(255)
  type            String             @db.VarChar(100)
  status          BillingEventStatus @default(RECEIVED)
  payload         Json               @default("{}")
  processedAt     DateTime?          @map("processed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  user            User?              @relation(fields: [userId], references: [id])

  @@unique([provider, externalEventId])
  @@index([userId, createdAt])
  @@map("billing_events")
}

// ==================== SEO / CONTENT ====================

model ToolPage {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(100)
  locale      String   @db.VarChar(5)
  title       String   @db.VarChar(255)
  description String   @db.VarChar(500)
  h1          String   @db.VarChar(255)
  content     Json     @default("{}")
  faq         Json     @default("[]")
  metadata    Json     @default("{}")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@map("tool_pages")
}

model Redirect {
  id        String       @id @default(uuid()) @db.Uuid
  from      String       @db.VarChar(500)
  to        String       @db.VarChar(500)
  type      RedirectType @default(MOVED_PERMANENTLY)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([from])
  @@map("redirects")
}

// ==================== SECURITY / AUDIT ====================

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String   @db.VarChar(100)
  resource       String   @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  details        Json     @default("{}")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId, createdAt])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @db.VarChar(50)
  severity  Severity @default(INFO)
  details   Json     @default("{}")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@map("security_events")
}

// ==================== SYSTEM ====================

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  enabled     Boolean  @default(false)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

