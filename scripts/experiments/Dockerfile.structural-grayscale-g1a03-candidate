# syntax=docker/dockerfile:1.7
# G1-A/03 supply-chain candidate only. The base tag must be built from the
# unchanged Dockerfile.worker. This image is never a production worker target.
FROM dip-document-worker:g1a03-base

LABEL org.opencontainers.image.title="DIP Structural Grayscale G1-A/03 Candidate" \
      org.opencontainers.image.description="Isolated dependency and supply-chain verification candidate" \
      dev.dip.scope="g1a03-candidate-only" \
      dev.dip.production-adoption="not-approved" \
      dev.dip.public-exposure="false"

USER root
COPY .g1a03-wheelhouse /wheels
COPY scripts/experiments/structural-grayscale-stage3b.requirements.txt /candidate/requirements.txt

RUN python3 -m venv /opt/dip-gray-candidate \
 && /opt/dip-gray-candidate/bin/pip install --no-cache-dir --disable-pip-version-check \
      --no-index --find-links=/wheels -r /candidate/requirements.txt \
 && /opt/dip-gray-candidate/bin/python -m pip check \
 && test ! -e /usr/bin/gs \
 && test ! -e /usr/local/bin/gs \
 && rm -rf /wheels /root/.cache

USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/opt/dip-gray-candidate/bin/python", "-c", "import sys; print('G1-A/03 candidate only; no product dispatch'); sys.exit(0)"]
