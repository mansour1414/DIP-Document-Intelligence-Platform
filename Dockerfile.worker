# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22.20.0-bookworm-slim

FROM ${NODE_IMAGE} AS node-deps
WORKDIR /app
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate && npm prune --omit=dev

FROM ${NODE_IMAGE} AS runtime
ARG OCRMYPDF_VERSION=17.10.0
ARG PYPDFIUM2_VERSION=5.13.0
ARG QPDF_DEBIAN_VERSION=11.3.0-1+deb12u1

ENV NODE_ENV=production \
    PATH="/opt/dip-ocr/bin:${PATH}"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      ca-certificates \
      fonts-noto-core \
      fonts-noto-extra \
      libreoffice-calc \
      libreoffice-impress \
      libreoffice-writer \
      python3 \
      python3-venv \
      "qpdf=${QPDF_DEBIAN_VERSION}" \
      tesseract-ocr \
      tesseract-ocr-ara \
      tesseract-ocr-eng \
      tini \
 && python3 -m venv /opt/dip-ocr \
 && /opt/dip-ocr/bin/python -m pip install --no-cache-dir --disable-pip-version-check \
      "ocrmypdf==${OCRMYPDF_VERSION}" "pypdfium2==${PYPDFIUM2_VERSION}" \
 && test ! -e /usr/bin/gs \
 && test ! -e /usr/local/bin/gs \
 && test "$(dpkg-query -W -f='${Version}' qpdf)" = "${QPDF_DEBIAN_VERSION}" \
 && rm -rf /var/lib/apt/lists/* /root/.cache

WORKDIR /app
RUN groupadd --system --gid 10001 dipworker \
 && useradd --system --uid 10001 --gid dipworker --home-dir /home/dipworker --create-home dipworker \
 && install -d -o dipworker -g dipworker -m 0700 /tmp/dip

ENV HOME=/home/dipworker \
    TMPDIR=/tmp/dip

COPY --from=node-deps --chown=dipworker:dipworker /app/node_modules ./node_modules
COPY --chown=dipworker:dipworker package.json tsconfig.json sentry.server.config.ts ./
COPY --chown=dipworker:dipworker prisma ./prisma
COPY --chown=dipworker:dipworker src ./src
COPY --chown=dipworker:dipworker workers ./workers
COPY --chown=dipworker:dipworker scripts/verify-ocr-runtime.py ./scripts/verify-ocr-runtime.py
COPY --chown=dipworker:dipworker scripts/verify-qpdf-security-runtime.mjs ./scripts/verify-qpdf-security-runtime.mjs
# B31-04: the bounded PDF child is launched with the same `--import` preloads the
# worker itself uses. Without this file in the image, `--import
# ./scripts/node-platform-compat.mjs` fails and *every* Fill Forms job would die
# with WORKER_CRASHED at the first inspection — while every test here passed,
# because the repository checkout happens to contain it. The child entry itself
# ships inside `src/` (copied above), and `form-worker.ts` asserts its presence at
# startup rather than failing per-request in production.
COPY --chown=dipworker:dipworker scripts/node-platform-compat.mjs ./scripts/node-platform-compat.mjs

# Packaging verification, at build time, against the image's own files.
# The child is launched with `tsx` and `--import ./scripts/node-platform-compat.mjs`;
# neither is visible to a bundler, so nothing except this check would notice their
# absence until the first Fill Forms job failed in production.
# R7C: the verifier selects native packages per target, so it needs the selection module
# beside it. Three small, dependency-free ESM files.
COPY --chown=dipworker:dipworker scripts/pdf-worker-platform.mjs ./scripts/pdf-worker-platform.mjs
COPY --chown=dipworker:dipworker scripts/write-pdf-worker-target.mjs ./scripts/write-pdf-worker-target.mjs
COPY --chown=dipworker:dipworker scripts/verify-pdf-worker-artifact.mjs ./scripts/verify-pdf-worker-artifact.mjs

# B31-04: presence is necessary and not sufficient. This script *runs* the child inside
# the image and drives it through the real protocol — inspect, fill, flatten, and an
# Arabic value that exercises the native canvas and the bundled font. Each of those can
# fail at runtime with every required file present (a wrong-platform native addon, an
# unresolvable font, an unresolved path alias), which is invisible to a file check.
COPY --chown=dipworker:dipworker scripts/smoke-pdf-worker-artifact.mjs ./scripts/smoke-pdf-worker-artifact.mjs
# R6.4: the production-runner scenario imports the image's own `form-worker.ts` and calls
# the real bounded API. This module used to be composed at test time *inside* the
# artifact, which fails here with EROFS: the runtime stage runs a read-only root
# filesystem on purpose. Shipping the module keeps the scenario and the security
# configuration intact instead of trading one for the other.
COPY --chown=dipworker:dipworker scripts/pdf-worker-runner-smoke.ts ./scripts/pdf-worker-runner-smoke.ts

# R7C: the native packages are selected per target now, so the check must state which
# target it is checking. When the image is built for another CPU (`docker buildx
# --platform`) the verifier would otherwise default to the *builder's* architecture and
# report a foreign artifact complete while its own natives were missing — the ARM64
# defect. TARGETARCH is BuildKit's own value for the *output* platform. The image is
# Debian bookworm, so libc is always glibc here; TARGETVARIANT is irrelevant.
ARG TARGETARCH
RUN node scripts/write-pdf-worker-target.mjs --root /app --libc glibc \
 && node scripts/verify-pdf-worker-artifact.mjs /app \
 && node scripts/smoke-pdf-worker-artifact.mjs /app --in-place \
 && python3 scripts/verify-ocr-runtime.py \
 && soffice --version \
 && qpdf --version \
 && tesseract --version \
 && node --version \
 && test ! -e /usr/bin/gs \
 && test ! -e /usr/local/bin/gs

USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "--import", "tsx", "workers/document-worker.ts"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "process.kill(1,0)"]
