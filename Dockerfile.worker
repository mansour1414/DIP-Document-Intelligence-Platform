# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22.20.0-bookworm-slim

FROM ${NODE_IMAGE} AS node-deps
WORKDIR /app
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate && npm prune --omit=dev

FROM ${NODE_IMAGE} AS runtime
ARG OCRMYPDF_VERSION=17.10.0
ARG PYPDFIUM2_VERSION=5.13.0
ARG QPDF_DEBIAN_VERSION=11.3.0-1+deb12u1

ENV NODE_ENV=production \
    PATH="/opt/dip-ocr/bin:${PATH}"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      ca-certificates \
      fonts-noto-core \
      fonts-noto-extra \
      libreoffice-calc \
      libreoffice-impress \
      libreoffice-writer \
      python3 \
      python3-venv \
      "qpdf=${QPDF_DEBIAN_VERSION}" \
      tesseract-ocr \
      tesseract-ocr-ara \
      tesseract-ocr-eng \
      tini \
 && python3 -m venv /opt/dip-ocr \
 && /opt/dip-ocr/bin/python -m pip install --no-cache-dir --disable-pip-version-check \
      "ocrmypdf==${OCRMYPDF_VERSION}" "pypdfium2==${PYPDFIUM2_VERSION}" \
 && test ! -e /usr/bin/gs \
 && test ! -e /usr/local/bin/gs \
 && test "$(dpkg-query -W -f='$${Version}' qpdf)" = "${QPDF_DEBIAN_VERSION}" \
 && rm -rf /var/lib/apt/lists/* /root/.cache

WORKDIR /app
RUN groupadd --system --gid 10001 dipworker \
 && useradd --system --uid 10001 --gid dipworker --home-dir /home/dipworker --create-home dipworker \
 && install -d -o dipworker -g dipworker -m 0700 /tmp/dip

ENV HOME=/home/dipworker \
    TMPDIR=/tmp/dip

COPY --from=node-deps --chown=dipworker:dipworker /app/node_modules ./node_modules
COPY --chown=dipworker:dipworker package.json tsconfig.json sentry.server.config.ts ./
COPY --chown=dipworker:dipworker prisma ./prisma
COPY --chown=dipworker:dipworker src ./src
COPY --chown=dipworker:dipworker workers ./workers
COPY --chown=dipworker:dipworker scripts/verify-ocr-runtime.py ./scripts/verify-ocr-runtime.py

RUN python3 scripts/verify-ocr-runtime.py \
 && soffice --version \
 && qpdf --version \
 && tesseract --version \
 && node --version \
 && test ! -e /usr/bin/gs \
 && test ! -e /usr/local/bin/gs

USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "--import", "tsx", "workers/document-worker.ts"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "process.kill(1,0)"]
